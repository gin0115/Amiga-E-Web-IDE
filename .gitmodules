[submodule "ecomp"]
	path = ecomp
	url = https://github.com/gin0115/Amiga-E-Compiler-WebBased.git
	# ecomp is developed in its own repo; the IDE's recorded pointer is managed
	# separately. Ignore pointer/dirty changes so the gitlink never shows up in
	# `git status` and can't be staged by `git add -A` / `git commit -a`.
	ignore = all
[submodule "help"]
	path = docs
	url = https://github.com/gin0115/Amiga-E-Docs-Site.git
